			"kind": "custom",
			"refersTo": "card",
			"description": "Run detail signature: telemetry spans on a time axis, untimed graded step marks.",
			"html": "<div class=\"ds-trace\"><span class=\"ds-trace-id\">superpowers-t1<small>42.3m · $3.10</small></span><div class=\"ds-trace-track\"><button class=\"ds-span ds-span-setup\" style=\"left:0;width:8%\" title=\"Setup\"></button><button class=\"ds-span ds-span-session\" style=\"left:8%;width:62%\" title=\"Session 1\"></button><button class=\"ds-span ds-span-session\" style=\"left:70%;width:20%\" title=\"Session 2\"></button><button class=\"ds-span ds-span-setup\" style=\"left:90%;width:6%\" title=\"Archive &amp; teardown\"></button></div><span class=\"ds-trace-graded\"><b>84</b><i class=\"ds-m ds-pass\"></i><i class=\"ds-m ds-pass\"></i><i class=\"ds-m ds-partial\"></i><i class=\"ds-m ds-pass\"></i><i class=\"ds-m ds-fail\"></i></span></div>",
			"css": ".ds-trace{display:grid;grid-template-columns:200px 1fr 150px;align-items:center;border:1px solid var(--border,#e7e9ed);border-radius:12px;background:var(--card,#fff);font-family:var(--font-sans,Geist,ui-sans-serif,system-ui,sans-serif);overflow:hidden;transition:background-color .15s}.ds-trace:hover{background:var(--muted,#f6f7f9)}.ds-trace-id{display:grid;padding:10px 12px 10px 20px;font-family:var(--font-mono,'Geist Mono',ui-monospace,monospace);font-size:12.5px;font-weight:500}.ds-trace-id small{font-family:var(--font-sans,Geist,ui-sans-serif,system-ui,sans-serif);font-size:12px;font-weight:400;color:var(--muted-foreground,#5f6672)}.ds-trace-track{position:relative;height:44px;background:linear-gradient(90deg,var(--border,#e7e9ed) 1px,transparent 1px);background-size:20% 100%}.ds-span{position:absolute;top:50%;height:12px;padding:0;border:0;border-right:1px solid var(--card,#fff);transform:translateY(-50%);cursor:pointer}.ds-span:first-child{border-radius:3px 0 0 3px}.ds-span:last-child{border-radius:0 3px 3px 0;border-right:0}.ds-span:focus-visible{outline:2px solid var(--ring,#2f6fed);outline-offset:1px}.ds-span-setup{background:var(--span-setup,#b7bdc7)}.ds-span-session{background:var(--primary,#2f6fed)}.ds-trace-graded{display:flex;align-items:center;gap:1px;padding:0 12px}.ds-trace-graded b{width:28px;margin-right:8px;text-align:right;font-family:var(--font-mono,'Geist Mono',ui-monospace,monospace);font-size:13px}.ds-m{display:inline-block;width:3px;height:12px;border-radius:1px}.ds-pass{background:var(--success-mark,#22a55b)}.ds-partial{background:var(--warn-mark,#e0a00f)}.ds-fail{background:var(--danger-mark,#e5484d)}"
