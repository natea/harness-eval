	"narrative": {
		"northStar": "The Audited Ledger",
		"overview": "The Studio is a category-standard eval dashboard built to the craft level of Braintrust, Linear and Vercel: one sidebar, one page header, a chart above a table. Nothing on a page is decorative; every mark is a number, a state, or the way to its evidence. Density is desk-grade (14px body, 32px controls, 13px table text), tuned for long operator sessions on a laptop or large monitor and for screenshots in demos.\n\nNeutrals are cool greys that differ only by lightness. A single blue carries data marks, the primary action's surrounding affordances and focus; green, amber and red speak only for outcomes and run state. Geist sets the interface and Geist Mono sets every machine value. Depth comes from 1px borders and tonal steps between sidebar, canvas and card, not from shadows.\n\nThe one exception to the canon is run detail, which is a trace waterfall: trials as traces, setup and build sessions as timed spans drawn from real telemetry, grading as untimed outcome marks. Light and dark are both first-class and chosen by a light / dark / system switch.",
		"keyCharacteristics": [
			"Sidebar + page header + chart over table, at 1280px max content width.",
			"One accent (primary blue) for data marks, focus and selection; semantic colour only for outcomes and run state.",
			"Geist for UI, Geist Mono with tabular figures for every id, hash, score, $ and duration.",
			"Flat surfaces: 1px borders, 8px controls, 12px cards, shadows only on floating layers.",
			"The numbers tell the truth: not-separable callouts, \"—\" for undefined statistics, \"*\" on within-run-normalized dimensions."
		],
		"rules": [
			{
				"name": "The One Accent Rule",
				"body": "Primary blue is for data marks, focus and selection. It is never a page decoration, a heading colour or a button fill.",
				"section": "colors"
			},
			{
				"name": "The Reserved Semantics Rule",
				"body": "Green, amber and red mean pass, partial and fail, or run state (graded, capped, inconclusive, infra-failed). They never decorate, and they never appear without a shape or a word beside them.",
				"section": "colors"
			},
			{
				"name": "The Machine Value Rule",
				"body": "Every id, hash, score, cost, token count, model id and duration is set in Geist Mono with tabular figures. Prose is never mono.",
				"section": "typography"
			},
			{
				"name": "The One Precision Rule",
				"body": "Each scoring dimension has one display precision everywhere, via `fmtDim`: code quality whole, the others one decimal. Durations format through `fmtMin`, money through `fmtUsd` (two decimals), run dates through `fmtRunDate`; a missing value prints \"—\".",
				"section": "typography"
			},
			{
				"name": "The Weights at the Foot Rule",
				"body": "Re-weighting lives as an inline strip at the foot of the standings table card (muted fill, top hairline, presets left and four sliders right), on both the Leaderboard and run detail. It is part of the table it re-ranks, not a side card.",
				"section": "layout"
			},
			{
				"name": "The Flat-At-Rest Rule",
				"body": "Cards, tables, callouts and chips carry a border and no shadow. A shadow means \"this floats over the page\".",
				"section": "elevation"
			}
		],
		"dos": [
			"**Do** make the primary button foreground-on-background (ink fill, canvas text), 32px tall, 8px radius.",
			"**Do** reserve primary blue for data marks, selection and the 2px focus outline.",
			"**Do** set every machine value in Geist Mono with tabular figures, formatted through `fmtDim`, `fmtMin`, `fmtUsd` or `fmtRunDate`.",
			"**Do** show the not-separable / single-trial callout above any ranking that overlaps or rests on n=1, and print the chart's n.",
			"**Do** print \"—\" for σ when fewer than two trials are counted, and for any missing value.",
			"**Do** mark within-run-normalized dimensions with \"*\" (Speed*, Token spend*) and say they do not compare across runs.",
			"**Do** pair every semantic colour with a shape or a word (outcome icon, badge text, callout title).",
			"**Do** keep re-weighting as the inline strip at the foot of the standings table.",
			"**Do** define colour once in the `:root` / `.dark` blocks of index.css and reach it through tokens."
		],
		"donts": [
			"**Don't** fill buttons, headings or backgrounds with the accent.",
			"**Don't** use green, amber or red for anything but outcomes and run state.",
			"**Don't** put shadows on cards, tables, chips or callouts; shadows are for overlays, the dialog and slider thumbs.",
			"**Don't** set prose, labels or headings in mono, or machine values in Geist.",
			"**Don't** add uppercase tracked kickers or eyebrows above titles; labels are sentence case.",
			"**Don't** present an inconclusive or single-trial order as a win.",
			"**Don't** hard-code hex colours in components."
		]
	}
}
