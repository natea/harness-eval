			"css": ".ds-callout{display:flex;align-items:flex-start;gap:12px;padding:12px 16px;border:1px solid color-mix(in srgb,var(--warn,#a15c07) 25%,transparent);border-radius:12px;background:var(--warn-bg,#fdf5e6);color:var(--foreground,#111318);font-family:var(--font-sans,Geist,ui-sans-serif,system-ui,sans-serif);font-size:13.5px}.ds-callout svg{flex-shrink:0;margin-top:2px;color:var(--warn,#a15c07)}.ds-callout p{margin:0}"
		},
