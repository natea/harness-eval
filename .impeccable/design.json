			"description": "Dot at the composite, primary band over its min-max range, mono value.",
			"html": "<div class=\"ds-chart\"><div class=\"ds-chart-row\"><span class=\"ds-chart-label\">agent-skills</span><div class=\"ds-chart-track\"><span class=\"ds-chart-band\" style=\"left:58%;width:14%\"></span><span class=\"ds-chart-dot\" style=\"left:66%\"></span></div><span class=\"ds-chart-value\">66.4</span></div><div class=\"ds-chart-row\"><span class=\"ds-chart-label\">gsd</span><div class=\"ds-chart-track\"><span class=\"ds-chart-band\" style=\"left:55%;width:16%\"></span><span class=\"ds-chart-dot\" style=\"left:63%\"></span></div><span class=\"ds-chart-value\">63.1</span></div></div>",
			"css": ".ds-chart{display:grid;gap:4px;padding:20px;border:1px solid var(--border,#e7e9ed);border-radius:12px;background:var(--card,#fff);font-family:var(--font-sans,Geist,ui-sans-serif,system-ui,sans-serif)}.ds-chart-row{display:grid;grid-template-columns:140px 1fr 52px;align-items:center;gap:16px}.ds-chart-label{font-size:13.5px;font-weight:500}.ds-chart-track{position:relative;height:36px;background:linear-gradient(90deg,var(--border,#e7e9ed) 1px,transparent 1px);background-size:25% 100%}.ds-chart-band{position:absolute;top:50%;height:6px;transform:translateY(-50%);border-radius:9999px;background:color-mix(in srgb,var(--primary,#2f6fed) 25%,transparent)}.ds-chart-dot{position:absolute;top:50%;width:12px;height:12px;transform:translate(-50%,-50%);border-radius:9999px;background:var(--primary,#2f6fed);box-shadow:0 0 0 3px var(--card,#fff)}.ds-chart-value{text-align:right;font-family:var(--font-mono,'Geist Mono',ui-monospace,monospace);font-variant-numeric:tabular-nums;font-size:13.5px;font-weight:500}"
