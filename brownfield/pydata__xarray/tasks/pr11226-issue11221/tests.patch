+    from pathlib import Path
+
+    from zarr.storage import MemoryStore
+
+    import xarray as xr
+
+    ds = xr.open_zarr("store.zarr", chunks="auto")
+    reveal_type(ds)  # N: Revealed type is "xarray.core.dataset.Dataset"
+
+    xr.open_zarr(Path("store.zarr"), group="a/b", chunks=None, zarr_format=3)
+    xr.open_zarr(MemoryStore(), chunks={"x": 10}, consolidated=False)
+    xr.open_zarr(
+        "store.zarr",
+        mask_and_scale={"a": False},
+        decode_times=xr.coders.CFDatetimeCoder(use_cftime=True),
+        decode_timedelta={"b": xr.coders.CFTimedeltaCoder()},
+        drop_variables=["c"],
+        storage_options={"anon": True},
+    )
+
